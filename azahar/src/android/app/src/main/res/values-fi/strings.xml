    <string name="keep_emulation_running">Pidä emulointi käynnissä</string>
    <string name="keep_emulation_running_description">Älä keskeytä peliä, kun emulointi on taustalla. Hyödyllinen moninpelissä, jotta yhteys ei katkea aikakatkaisuun.</string>
    <string name="adreno_gpu_boost">Adreno GPU -tehostus (kokeellinen)</string>
    <string name="adreno_gpu_boost_description">Lisää grafiikan suoritustehoa tuetuilla laitteilla ja parantaa suorituskykyä. Tämän asetuksen käyttö voi lisätä virrankulutusta ja lämpötilaa. Voi aiheuttaa vakausongelmia joillakin laitteilla.</string>
    <string name="reduce_downcount_slice">Pienennä downcount-viipaletta</string>
    <string name="reduce_downcount_slice_description">Pienentää suorittimen aikaviipaletta, mikä voi parantaa joidenkin pelien vasteaikaa ja monisydämisen ajoituksen tarkkuutta suorituskyvyn kustannuksella.</string>
    <string name="priority_boost_starved_threads">Nälkiintyneiden säikeiden prioriteettitehostus</string>
    <string name="priority_boost_starved_threads_description">Tehostaa matalan prioriteetin nälkiintyneitä säikeitä ytimen uudelleenaikataulutuksen aikana. Tämä voi parantaa suorituskykyä.</string>
    <string name="cpu_affinity_mode">Suorittimen ytimien affiniteetti</string>
    <string name="cpu_affinity_mode_description">Kiinnittää emulointi- ja GPU-säikeet tiettyihin suorittimen ytimiin, kuten Winlator/GameHub. Tulee voimaan seuraavan kerran, kun peli käynnistetään. Tulokset vaihtelevat laitteittain. Jätä asetukseksi Oletus, jos suorituskyky heikkenee.</string>
    <string name="cpu_affinity_default">Oletus (käyttöjärjestelmä päättää)</string>
    <string name="cpu_affinity_big">Big- + prime-ytimet</string>
    <string name="cpu_affinity_prime">Vain prime-ydin</string>
    <string name="cpu_affinity_little">Vain little-ytimet</string>
    <string name="use_fastmem">Käytä Fastmemiä</string>
    <string name="use_fastmem_description">Ota käyttöön suora muistinkäyttö JIT:lle (nopeampi, poista käytöstä, jos kaatuilee). Tulee voimaan seuraavan kerran, kun peli käynnistetään.</string>
    <string name="tweaks">Viritykset</string>
    <string name="force_hw_vertex_shaders">Pakota laitteiston vertex-varjostimet</string>
    <string name="force_hw_vertex_shaders_description">Ei koskaan käytä hidasta ohjelmallista vertex-varjostinpolkua. Piirtokutsut, joita ei voi suorittaa GPU:lla, ohitetaan. Voi parantaa suorituskykyä, mutta grafiikkaa saattaa puuttua.</string>
    <string name="disable_surface_texture_copy">Poista pintatekstuurin kopiointi käytöstä</string>
    <string name="disable_surface_texture_copy_description">Ohittaa tekstuurikopiot, kun välimuistissa ei ole lähdettä. Voi parantaa suorituskykyä hieman, mutta voi aiheuttaa grafiikkavirheitä.</string>
    <string name="disable_flush_cpu_write">Poista CPU-kirjoituksen tyhjennys käytöstä</string>
    <string name="disable_flush_cpu_write_description">Ohittaa välimuistissa olevien pintojen tyhjennyksen pienissä CPU-kirjoituksissa. Voi vähentää nykimistä, mutta voi aiheuttaa grafiikkavirheitä.</string>
