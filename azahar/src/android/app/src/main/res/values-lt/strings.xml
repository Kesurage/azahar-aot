    <string name="keep_emulation_running">Palikti emuliaciją veikti</string>
    <string name="keep_emulation_running_description">Nestabdyti žaidimo, kai emuliacija veikia fone. Naudinga žaidžiant kelis žaidėjus, kad nenutrūktų ryšys.</string>
    <string name="adreno_gpu_boost">Adreno GPU spartinimas (eksperimentinis)</string>
    <string name="adreno_gpu_boost_description">Padidina grafikos pralaidumą palaikomuose įrenginiuose ir pagerina našumą. Naudojant šį nustatymą gali padidėti energijos sąnaudos ir temperatūra. Kai kuriuose įrenginiuose gali sukelti stabilumo problemų.</string>
    <string name="reduce_downcount_slice">Sumažinti downcount laiko tarpsnį</string>
    <string name="reduce_downcount_slice_description">Sumažina procesoriaus laiko tarpsnį, o tai kai kuriuose žaidimuose gali pagerinti reakciją ir daugiabranduolį laiko derinimą, bet šiek tiek sumažina našumą.</string>
    <string name="priority_boost_starved_threads">Badaujančių gijų prioriteto didinimas</string>
    <string name="priority_boost_starved_threads_description">Branduolio perplanavimo metu padidina žemo prioriteto badaujančių gijų prioritetą. Tai gali pagerinti našumą.</string>
    <string name="cpu_affinity_mode">Procesoriaus branduolių afinitetas</string>
    <string name="cpu_affinity_mode_description">Priskiria emuliacijos ir GPU gijas konkretiems procesoriaus branduoliams, panašiai kaip Winlator/GameHub. Įsigalioja kitą kartą paleidus žaidimą. Rezultatai skiriasi priklausomai nuo įrenginio; jei našumas pablogėja, palikite numatytąjį.</string>
    <string name="cpu_affinity_default">Numatytasis (nusprendžia OS)</string>
    <string name="cpu_affinity_big">Dideli + pagrindinis branduoliai</string>
    <string name="cpu_affinity_prime">Tik pagrindinis branduolys</string>
    <string name="cpu_affinity_little">Tik maži branduoliai</string>
    <string name="use_fastmem">Naudoti Fastmem</string>
    <string name="use_fastmem_description">Įjungia tiesioginę atminties prieigą JIT (greičiau; išjunkite, jei strigtų). Įsigalioja kitą kartą paleidus žaidimą.</string>
    <string name="tweaks">Pakeitimai</string>
    <string name="force_hw_vertex_shaders">Priverstiniai aparatiniai viršūnių šešėliuokliai</string>
    <string name="force_hw_vertex_shaders_description">Niekada nenaudoja lėto programinio viršūnių šešėliuoklių kelio. Piešimo komandos, kurių negalima vykdyti GPU, praleidžiamos. Gali pagerinti našumą, bet gali trūkti grafikos elementų.</string>
    <string name="disable_surface_texture_copy">Išjungti paviršiaus tekstūrų kopijavimą</string>
    <string name="disable_surface_texture_copy_description">Praleidžia tekstūrų kopijavimą, kai nėra talpykloje esančio šaltinio. Gali šiek tiek pagerinti našumą, bet gali sukelti grafikos klaidų.</string>
    <string name="disable_flush_cpu_write">Išjungti CPU įrašymo išvalymą</string>
    <string name="disable_flush_cpu_write_description">Praleidžia talpykloje esančių paviršių išvalymą po mažų CPU įrašymų. Gali sumažinti trūkčiojimą, bet gali sukelti grafikos klaidų.</string>
