    <string name="render_3d_which_display">Atvaizduoti stereoskopinį 3D</string>
    <string name="side_by_side_full">Greta, visas plotis</string>
    <string name="render3d_description">Pasirinkite stereoskopinio 3D režimą 3D atvaizdavimui. Šiuo metu dažniausiai naudojami režimai „Greta“. Anaglyph ir Interlaced režimai visada taikomi visiems prijungtiems ekranams.</string>
    <string name="swap_eyes_3d">Sukeisti akis</string>
    <string name="swap_eyes_3d_description">Sukeičia, kuri akis rodoma kurioje pusėje. Kartu su režimu „Greta“ leidžia matyti 3D, sukryžiavus akis!</string>
    <string name="use_skip_duplicate_frames">Praleisti pasikartojančių kadrų rodymą</string>
    <string name="use_skip_duplicate_frames_description">Praleidžia nepasikartojančių kadrų rodymą. Taip pat leidžia išoriniams kadrų generavimo įrankiams teisingai veikti su 30 FPS žaidimais</string>
    <string name="layouts_to_cycle">Kaitaliojami išdėstymai</string>
    <string name="layouts_to_cycle_description">Kuriuos išdėstymus kaitalioja išdėstymo keitimo spartusis klavišas</string>
    <string name="emulation_secondary_display_enable">Įjungti antrinį ekraną</string>
    <string name="emulation_secondary_display_enable_description">Jei išjungta, Azahar leis Android valdyti prijungtus ekranus. Jei įjungta ir prijungta keli ekranai, galite pasirinkti, kurį naudos Azahar, spartajame emuliacijos meniu</string>
    <string name="emulation_switch_secondary_layout">Antrinio ekrano išdėstymas</string>
