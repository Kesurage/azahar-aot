    <string name="emulation_secondary_display_enable">Aktiver sekundær skjerm</string>
    <string name="emulation_secondary_display_enable_description">Hvis deaktivert, lar Azahar Android styre tilkoblede skjermer. Hvis aktivert og flere skjermer er tilkoblet, kan du velge hvilken Azahar skal bruke i hurtigmenyen for emulering</string>
