    <string name="swap_eyes_3d_description">Bytter hvilket øye som vises på hvilken side. Kombinert med side ved side-modus kan du se 3D ved å skjele!</string>
    <string name="use_skip_duplicate_frames">Hopp over like bilder</string>
    <string name="use_skip_duplicate_frames_description">Hopper over visning av bilder som ikke er unike. Det gjør også at eksterne verktøy for bildegenerering fungerer riktig med 30 FPS-spill</string>
