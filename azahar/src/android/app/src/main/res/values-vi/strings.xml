    <string name="render3d_description">Chọn chế độ 3D lập thể cho kết xuất 3D. Chế độ cạnh nhau là phổ biến nhất hiện nay. Chế độ Anaglyph và xen kẽ luôn áp dụng cho tất cả màn hình đã kết nối.</string>
    <string name="swap_eyes_3d">Đổi mắt</string>
    <string name="swap_eyes_3d_description">Hoán đổi mắt nào được hiển thị ở bên nào. Kết hợp với chế độ cạnh nhau, bạn có thể xem 3D bằng cách nhìn chéo mắt!</string>
    <string name="use_skip_duplicate_frames">Bỏ qua hiển thị khung hình trùng lặp</string>
    <string name="use_skip_duplicate_frames_description">Bỏ qua việc hiển thị các khung hình không khác nhau. Điều này cũng giúp các công cụ tạo khung hình bên ngoài hoạt động đúng với game 30fps</string>
    <string name="layouts_to_cycle">Bố cục để chuyển đổi</string>
    <string name="layouts_to_cycle_description">Chọn các bố cục sẽ được chuyển đổi khi dùng phím tắt chuyển bố cục</string>
    <string name="emulation_secondary_display_enable">Bật màn hình phụ</string>
    <string name="emulation_secondary_display_enable_description">Nếu tắt, Azahar sẽ để Android quản lý các màn hình đã kết nối. Nếu bật và có nhiều màn hình được kết nối, bạn có thể chọn màn hình Azahar sẽ dùng trong Menu nhanh khi giả lập</string>
    <string name="emulation_switch_secondary_layout">Bố cục màn hình phụ</string>
    <string name="emulation_secondary_display_opposite">Màn hình đối diện</string>
    <string name="use_fastinterp">Dùng trình thông dịch nhanh</string>
    <string name="use_fastinterp_description">Khi CPU JIT bị tắt, dùng trình thông dịch nhanh thay cho trình thông dịch cũ. Cần khởi động lại.</string>
    <string name="simulate_3ds_gpu_timings">Mô phỏng thời gian GPU của 3DS</string>
    <string name="simulate_3ds_gpu_timings_description">Trì hoãn các sự kiện hoàn tất GPU dựa trên số liệu đo từ phần cứng thật, để game có số đo thời gian GPU thực tế hơn. Giúp ổn định các game có FPS động. Tắt tính năng này có thể cải thiện hiệu năng trong một số ít trường hợp nhưng đánh đổi bằng độ ổn định.</string>
