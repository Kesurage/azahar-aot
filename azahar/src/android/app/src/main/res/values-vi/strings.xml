    <string name="chat_max_lines_description">Đặt số tin nhắn trò chuyện tối đa hiển thị trong lớp phủ.</string>
    <string name="keep_emulation_running">Giữ giả lập tiếp tục chạy</string>
    <string name="keep_emulation_running_description">Không tạm dừng game khi giả lập chạy nền. Hữu ích cho chế độ nhiều người chơi để không bị hết thời gian chờ kết nối.</string>
    <string name="adreno_gpu_boost">Tăng tốc GPU Adreno (Thử nghiệm)</string>
    <string name="adreno_gpu_boost_description">Tăng thông lượng đồ họa trên các thiết bị được hỗ trợ, giúp cải thiện hiệu năng. Việc dùng cài đặt này có thể làm tăng mức tiêu thụ điện và nhiệt độ. Có thể gây mất ổn định trên một số thiết bị.</string>
    <string name="reduce_downcount_slice">Giảm Downcount Slice</string>
    <string name="reduce_downcount_slice_description">Giảm time slice của CPU, có thể cải thiện độ phản hồi và định thời đa nhân ở một số game, đổi lại hiệu năng bị giảm.</string>
    <string name="priority_boost_starved_threads">Tăng ưu tiên cho luồng bị bỏ đói</string>
    <string name="priority_boost_starved_threads_description">Tăng ưu tiên cho các luồng ưu tiên thấp bị bỏ đói (starved) trong quá trình lập lịch lại của kernel. Có thể cải thiện hiệu năng.</string>
    <string name="cpu_affinity_mode">Gắn nhân CPU (Affinity)</string>
    <string name="cpu_affinity_mode_description">Gắn các luồng giả lập và GPU vào các nhân CPU cụ thể, tương tự Winlator/GameHub. Có hiệu lực vào lần khởi động game tiếp theo. Kết quả khác nhau tùy thiết bị; hãy để ở Mặc định nếu hiệu năng giảm.</string>
    <string name="cpu_affinity_default">Mặc định (do hệ điều hành quyết định)</string>
    <string name="cpu_affinity_big">Nhân Big + Prime</string>
    <string name="cpu_affinity_prime">Chỉ nhân Prime</string>
    <string name="cpu_affinity_little">Chỉ nhân Little</string>
    <string name="use_fastmem">Dùng Fastmem</string>
    <string name="use_fastmem_description">Bật truy cập bộ nhớ trực tiếp cho JIT (nhanh hơn, hãy tắt nếu bị crash). Có hiệu lực vào lần khởi động game tiếp theo.</string>
    <string name="tweaks">Tinh chỉnh</string>
    <string name="force_hw_vertex_shaders">Buộc dùng vertex shader phần cứng</string>
    <string name="force_hw_vertex_shaders_description">Không bao giờ dùng đường vertex shader phần mềm chậm. Các lệnh vẽ không thể chạy trên GPU sẽ bị bỏ qua. Có thể tăng hiệu năng nhưng có thể gây mất hình ảnh.</string>
    <string name="disable_surface_texture_copy">Tắt sao chép texture bề mặt</string>
    <string name="disable_surface_texture_copy_description">Bỏ qua việc sao chép texture khi không có nguồn trong bộ đệm. Có thể tăng nhẹ hiệu năng nhưng có thể gây lỗi đồ họa.</string>
    <string name="disable_flush_cpu_write">Tắt flush khi CPU ghi</string>
    <string name="disable_flush_cpu_write_description">Bỏ qua việc flush các bề mặt trong bộ đệm khi CPU ghi rất ít dữ liệu. Có thể giảm giật lag nhưng có thể gây lỗi đồ họa.</string>
