    <string name="keep_emulation_running">保持模擬執行</string>
    <string name="keep_emulation_running_description">模擬器在背景時不暫停遊戲。適用於多人連線，避免逾時斷線。</string>
    <string name="adreno_gpu_boost">Adreno GPU 加速（實驗性）</string>
    <string name="adreno_gpu_boost_description">在支援的裝置上提高圖形吞吐量，改善效能。使用此設定可能會增加耗電量與溫度，並可能在部分裝置上造成穩定性問題。</string>
    <string name="reduce_downcount_slice">縮小 Downcount 時間片</string>
    <string name="reduce_downcount_slice_description">縮短 CPU 時間片，可在部分遊戲中提升回應速度與多核心時序，但會犧牲一些效能。</string>
    <string name="priority_boost_starved_threads">提升飢餓執行緒優先權</string>
    <string name="priority_boost_starved_threads_description">在核心重新排程時，提升處於飢餓狀態的低優先權執行緒。這可能會提升效能。</string>
    <string name="cpu_affinity_mode">CPU 核心親和性</string>
    <string name="cpu_affinity_mode_description">將模擬與 GPU 執行緒綁定到指定的 CPU 核心，類似 Winlator/GameHub。下次啟動遊戲時生效。效果因裝置而異；若效能變差，請維持預設。</string>
    <string name="cpu_affinity_default">預設（由系統決定）</string>
    <string name="cpu_affinity_big">大核心 + 超大核心</string>
    <string name="cpu_affinity_prime">僅超大核心</string>
    <string name="cpu_affinity_little">僅小核心</string>
    <string name="use_fastmem">使用 Fastmem</string>
    <string name="use_fastmem_description">為 JIT 啟用直接記憶體存取（更快，若當機請停用）。下次啟動遊戲時生效。</string>
    <string name="tweaks">調校</string>
    <string name="force_hw_vertex_shaders">強制硬體頂點著色器</string>
    <string name="force_hw_vertex_shaders_description">不再使用緩慢的軟體頂點著色器路徑。無法在 GPU 上執行的繪製將被略過。可能提升效能，但可能造成圖形缺失。</string>
    <string name="disable_surface_texture_copy">停用表面紋理複製</string>
    <string name="disable_surface_texture_copy_description">在沒有快取來源時略過紋理複製。可能小幅提升效能，但可能造成圖形錯誤。</string>
    <string name="disable_flush_cpu_write">停用清空 CPU 寫入</string>
    <string name="disable_flush_cpu_write_description">在 CPU 進行極小寫入時略過清空快取的表面。可能減少卡頓，但可能造成圖形錯誤。</string>
