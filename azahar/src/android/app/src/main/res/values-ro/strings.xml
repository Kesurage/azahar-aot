    <string name="keep_emulation_running">Menține emularea activă</string>
    <string name="keep_emulation_running_description">Nu pune jocul pe pauză când emularea rulează în fundal. Util în multiplayer pentru a nu fi deconectat din cauza inactivității.</string>
    <string name="adreno_gpu_boost">Adreno GPU Boost (experimental)</string>
    <string name="adreno_gpu_boost_description">Crește performanța grafică pe dispozitivele compatibile. Folosirea acestei setări poate crește consumul de energie și temperatura. Poate cauza probleme de stabilitate pe unele dispozitive.</string>
    <string name="reduce_downcount_slice">Reduce Downcount Slice</string>
    <string name="reduce_downcount_slice_description">Reduce felia de timp a CPU, ceea ce poate îmbunătăți reactivitatea și sincronizarea multi-core în unele jocuri, cu un cost de performanță.</string>
    <string name="priority_boost_starved_threads">Crește prioritatea thread-urilor starved</string>
    <string name="priority_boost_starved_threads_description">Crește prioritatea thread-urilor starved cu prioritate scăzută în timpul reprogramării din kernel. Acest lucru poate îmbunătăți performanța.</string>
    <string name="cpu_affinity_mode">Afinitatea nucleelor CPU</string>
    <string name="cpu_affinity_mode_description">Fixează thread-urile de emulare și de GPU pe anumite nuclee CPU, similar cu Winlator/GameHub. Se aplică la următoarea pornire a unui joc. Rezultatele diferă în funcție de dispozitiv; lasă pe Implicit dacă performanța scade.</string>
    <string name="cpu_affinity_default">Implicit (decide sistemul)</string>
    <string name="cpu_affinity_big">Nuclee big + prime</string>
    <string name="cpu_affinity_prime">Doar nucleul prime</string>
    <string name="cpu_affinity_little">Doar nucleele little</string>
    <string name="use_fastmem">Folosește Fastmem</string>
    <string name="use_fastmem_description">Activează accesul direct la memorie pentru JIT (mai rapid; dezactivează dacă apar crash-uri). Se aplică la următoarea pornire a unui joc.</string>
    <string name="tweaks">Ajustări</string>
    <string name="force_hw_vertex_shaders">Forțează vertex shaderele hardware</string>
    <string name="force_hw_vertex_shaders_description">Nu folosește niciodată calea lentă a vertex shaderelor software. Desenările care nu pot rula pe GPU sunt omise. Poate crește performanța, dar poate cauza lipsa unor elemente grafice.</string>
    <string name="disable_surface_texture_copy">Dezactivează copierea texturilor de suprafață</string>
    <string name="disable_surface_texture_copy_description">Omite copierea texturilor atunci când nu există o sursă în cache. Poate oferi un mic spor de performanță, dar poate cauza erori grafice.</string>
    <string name="disable_flush_cpu_write">Dezactivează Flush CPU Write</string>
    <string name="disable_flush_cpu_write_description">Omite golirea suprafețelor din cache la scrieri mici ale CPU. Poate reduce sacadarea, dar poate cauza erori grafice.</string>
