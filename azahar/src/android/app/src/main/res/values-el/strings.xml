    <string name="keep_emulation_running">Διατήρηση εξομοίωσης σε εκτέλεση</string>
    <string name="keep_emulation_running_description">Δεν γίνεται παύση του παιχνιδιού όταν η εξομοίωση είναι στο παρασκήνιο. Χρήσιμο στο πολλαπλών παικτών ώστε να μην λήξει ο χρόνος σύνδεσης.</string>
    <string name="adreno_gpu_boost">Ενίσχυση GPU Adreno (πειραματικό)</string>
    <string name="adreno_gpu_boost_description">Αυξάνει τη διεκπεραιωτική ικανότητα γραφικών σε υποστηριζόμενες συσκευές, βελτιώνοντας την απόδοση. Η χρήση της ρύθμισης μπορεί να αυξήσει την κατανάλωση ενέργειας και τη θερμοκρασία. Μπορεί να προκαλέσει προβλήματα σταθερότητας σε ορισμένες συσκευές.</string>
    <string name="reduce_downcount_slice">Μείωση downcount slice</string>
    <string name="reduce_downcount_slice_description">Μειώνει το χρονικό τμήμα της CPU, κάτι που μπορεί να βελτιώσει την ανταπόκριση και τον συγχρονισμό πολλών πυρήνων σε ορισμένα παιχνίδια, με κάποιο κόστος στην απόδοση.</string>
    <string name="priority_boost_starved_threads">Ενίσχυση προτεραιότητας νημάτων σε starvation</string>
    <string name="priority_boost_starved_threads_description">Ενισχύει νήματα χαμηλής προτεραιότητας που υφίστανται starvation κατά τον επαναπρογραμματισμό του πυρήνα. Μπορεί να βελτιώσει την απόδοση.</string>
    <string name="cpu_affinity_mode">Συγγένεια πυρήνων CPU</string>
    <string name="cpu_affinity_mode_description">Καρφιτσώνει τα νήματα εξομοίωσης και GPU σε συγκεκριμένους πυρήνες CPU, όπως στο Winlator/GameHub. Ισχύει από την επόμενη εκκίνηση παιχνιδιού. Τα αποτελέσματα διαφέρουν ανά συσκευή· αν η απόδοση χειροτερέψει, αφήστε την Προεπιλογή.</string>
    <string name="cpu_affinity_default">Προεπιλογή (αποφασίζει το λειτουργικό)</string>
    <string name="cpu_affinity_big">Big + prime πυρήνες</string>
    <string name="cpu_affinity_prime">Μόνο prime πυρήνας</string>
    <string name="cpu_affinity_little">Μόνο little πυρήνες</string>
    <string name="use_fastmem">Χρήση Fastmem</string>
    <string name="use_fastmem_description">Ενεργοποιεί την άμεση πρόσβαση στη μνήμη για το JIT (ταχύτερο, απενεργοποιήστε αν προκαλούνται κρασαρίσματα). Ισχύει από την επόμενη εκκίνηση παιχνιδιού.</string>
    <string name="tweaks">Τροποποιήσεις</string>
    <string name="force_hw_vertex_shaders">Επιβολή vertex shaders υλικού</string>
    <string name="force_hw_vertex_shaders_description">Δεν χρησιμοποιεί ποτέ τη αργή διαδρομή vertex shader λογισμικού. Οι κλήσεις σχεδίασης που δεν εκτελούνται στη GPU παραλείπονται. Μπορεί να βελτιώσει την απόδοση, αλλά να προκαλέσει ελλείποντα γραφικά.</string>
    <string name="disable_surface_texture_copy">Απενεργοποίηση αντιγραφής υφής επιφάνειας</string>
    <string name="disable_surface_texture_copy_description">Παραλείπει τις αντιγραφές υφών όταν δεν υπάρχει πηγή στην κρυφή μνήμη. Μπορεί να δώσει μικρή βελτίωση απόδοσης, αλλά να προκαλέσει σφάλματα γραφικών.</string>
    <string name="disable_flush_cpu_write">Απενεργοποίηση flush εγγραφής CPU</string>
    <string name="disable_flush_cpu_write_description">Παραλείπει το flush επιφανειών στην κρυφή μνήμη σε μικρές εγγραφές της CPU. Μπορεί να μειώσει το τρεμόπαιγμα, αλλά να προκαλέσει σφάλματα γραφικών.</string>
