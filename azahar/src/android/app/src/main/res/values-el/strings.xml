    <string name="side_by_side_full">Δίπλα-δίπλα, πλήρες πλάτος</string>
    <string name="render3d_description">Επιλέξτε τη στερεοσκοπική λειτουργία 3D για την απόδοση 3D. Οι λειτουργίες Δίπλα-δίπλα είναι οι πιο συνηθισμένες σήμερα. Οι λειτουργίες Anaglyph και Διαπλεκόμενη εφαρμόζονται πάντα σε όλες τις συνδεδεμένες οθόνες.</string>
    <string name="swap_eyes_3d">Εναλλαγή ματιών</string>
    <string name="swap_eyes_3d_description">Εναλλάσσει ποιο μάτι εμφανίζεται σε ποια πλευρά. Σε συνδυασμό με τη λειτουργία Δίπλα-δίπλα επιτρέπει να δείτε 3D διασταυρώνοντας τα μάτια σας!</string>
    <string name="use_skip_duplicate_frames">Παράλειψη εμφάνισης διπλών καρέ</string>
    <string name="use_skip_duplicate_frames_description">Παραλείπει την εμφάνιση καρέ που δεν είναι μοναδικά. Επιτρέπει επίσης σε εξωτερικά εργαλεία δημιουργίας καρέ να λειτουργούν σωστά με παιχνίδια 30 FPS</string>
    <string name="layouts_to_cycle">Διατάξεις προς εναλλαγή</string>
    <string name="layouts_to_cycle_description">Ποιες διατάξεις εναλλάσσονται με τη συντόμευση αλλαγής διάταξης</string>
    <string name="emulation_secondary_display_enable">Ενεργοποίηση δευτερεύουσας οθόνης</string>
    <string name="emulation_secondary_display_enable_description">Αν είναι απενεργοποιημένο, το Azahar θα αφήσει το Android να διαχειρίζεται τις συνδεδεμένες οθόνες. Αν είναι ενεργοποιημένο και υπάρχουν συνδεδεμένες πολλές οθόνες, μπορείτε να επιλέξετε ποια θα χρησιμοποιεί το Azahar από το Γρήγορο μενού εξομοίωσης</string>
    <string name="emulation_switch_secondary_layout">Διάταξη δευτερεύουσας οθόνης</string>
    <string name="emulation_secondary_display_opposite">Αντίθετη οθόνη</string>
    <string name="use_fastinterp">Χρήση γρήγορου διερμηνέα</string>
    <string name="use_fastinterp_description">Όταν το CPU JIT είναι απενεργοποιημένο, χρησιμοποιεί τον γρήγορο διερμηνέα αντί του παλαιού. Απαιτείται επανεκκίνηση.</string>
    <string name="simulate_3ds_gpu_timings">Προσομοίωση χρονισμών GPU του 3DS</string>
    <string name="simulate_3ds_gpu_timings_description">Καθυστερεί τα συμβάντα ολοκλήρωσης του GPU με βάση μετρήσεις από πραγματικό υλικό, ώστε τα παιχνίδια να έχουν πιο ρεαλιστικούς χρόνους GPU. Βοηθά στη σταθεροποίηση παιχνιδιών με δυναμικό FPS. Η απενεργοποίηση μπορεί σε σπάνιες περιπτώσεις να βελτιώσει την απόδοση εις βάρος της σταθερότητας.</string>
