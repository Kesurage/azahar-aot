    <string name="chat_max_lines_description">Megadja az overlayen megjelenő csevegőüzenetek maximális számát.</string>
    <string name="keep_emulation_running">Emuláció futtatása a háttérben</string>
    <string name="keep_emulation_running_description">Ne szüneteltesse a játékot, amikor az emuláció a háttérben van. Hasznos többjátékos módban, hogy ne járjon le az időkorlát.</string>
    <string name="adreno_gpu_boost">Adreno GPU Boost (kísérleti)</string>
    <string name="adreno_gpu_boost_description">Növeli a grafikai áteresztőképességet a támogatott eszközökön, javítva a teljesítményt. A beállítás használata növelheti az energiafogyasztást és a hőmérsékletet. Bizonyos eszközökön stabilitási problémákat okozhat.</string>
    <string name="reduce_downcount_slice">Downcount slice csökkentése</string>
    <string name="reduce_downcount_slice_description">Csökkenti a CPU időszeletét, ami egyes játékokban javíthatja a reakcióidőt és a többmagos időzítést, némi teljesítményveszteség árán.</string>
    <string name="priority_boost_starved_threads">Kiéheztetett szálak prioritásának növelése</string>
    <string name="priority_boost_starved_threads_description">Megnöveli az alacsony prioritású, kiéheztetett szálak prioritását a kernel újraütemezése során. Ez javíthatja a teljesítményt.</string>
    <string name="cpu_affinity_mode">CPU-mag affinitás</string>
    <string name="cpu_affinity_mode_description">Az emulációs és GPU-szálakat adott CPU-magokhoz rögzíti, hasonlóan a Winlator/GameHub-hoz. A következő játékindításkor lép életbe. Az eredmény eszközfüggő; ha romlik a teljesítmény, hagyd Alapértelmezetten.</string>
    <string name="cpu_affinity_default">Alapértelmezett (az OS dönt)</string>
    <string name="cpu_affinity_big">Big + prime magok</string>
    <string name="cpu_affinity_prime">Csak prime mag</string>
    <string name="cpu_affinity_little">Csak little magok</string>
    <string name="use_fastmem">Fastmem használata</string>
    <string name="use_fastmem_description">Közvetlen memóriahozzáférés engedélyezése a JIT számára (gyorsabb, összeomlás esetén kapcsold ki). A következő játékindításkor lép életbe.</string>
    <string name="tweaks">Finomhangolás</string>
    <string name="force_hw_vertex_shaders">Hardveres vertex shaderek kényszerítése</string>
    <string name="force_hw_vertex_shaders_description">Soha nem használja a lassú szoftveres vertex shader útvonalat. A GPU-n nem futtatható rajzolások kimaradnak. Teljesítménynövekedést adhat, de hiányzó grafikát okozhat.</string>
    <string name="disable_surface_texture_copy">Felületi textúramásolás letiltása</string>
    <string name="disable_surface_texture_copy_description">Kihagyja a textúramásolást, ha nincs gyorsítótárazott forrás. Kisebb teljesítménynövekedést adhat, de grafikai hibákat okozhat.</string>
    <string name="disable_flush_cpu_write">CPU-írás flush letiltása</string>
    <string name="disable_flush_cpu_write_description">Kihagyja a gyorsítótárazott felületek flush-olását apró CPU-írásoknál. Csökkentheti a megakadásokat, de grafikai hibákat okozhat.</string>
