    <string name="keep_emulation_running">Pertahankan Emulasi Tetap Berjalan</string>
    <string name="keep_emulation_running_description">Jangan jeda game saat emulasi berada di latar belakang. Berguna untuk multipemain agar tidak terputus karena waktu habis.</string>
    <string name="adreno_gpu_boost">Adreno GPU Boost (Eksperimental)</string>
    <string name="adreno_gpu_boost_description">Meningkatkan throughput grafis pada perangkat yang didukung sehingga performa membaik. Penggunaan pengaturan ini dapat meningkatkan konsumsi daya dan suhu. Dapat menyebabkan masalah stabilitas pada perangkat tertentu.</string>
    <string name="reduce_downcount_slice">Kurangi Downcount Slice</string>
    <string name="reduce_downcount_slice_description">Mengurangi slice waktu CPU, yang dapat meningkatkan responsivitas dan timing multi-core pada beberapa game dengan mengorbankan sedikit performa.</string>
    <string name="priority_boost_starved_threads">Naikkan Prioritas Thread yang Kelaparan</string>
    <string name="priority_boost_starved_threads_description">Menaikkan prioritas thread berprioritas rendah yang kelaparan (starved) saat penjadwalan ulang kernel. Ini dapat meningkatkan performa.</string>
    <string name="cpu_affinity_mode">Afinitas Inti CPU</string>
    <string name="cpu_affinity_mode_description">Menyematkan thread emulasi dan GPU ke inti CPU tertentu, mirip dengan Winlator/GameHub. Berlaku saat game dimulai berikutnya. Hasil bervariasi tiap perangkat; biarkan di Default jika performa memburuk.</string>
    <string name="cpu_affinity_default">Default (ditentukan OS)</string>
    <string name="cpu_affinity_big">Inti big + prime</string>
    <string name="cpu_affinity_prime">Hanya inti prime</string>
    <string name="cpu_affinity_little">Hanya inti little</string>
    <string name="use_fastmem">Gunakan Fastmem</string>
    <string name="use_fastmem_description">Aktifkan akses memori langsung untuk JIT (lebih cepat, nonaktifkan jika terjadi crash). Berlaku saat game dimulai berikutnya.</string>
    <string name="tweaks">Tweak</string>
    <string name="force_hw_vertex_shaders">Paksa Vertex Shader Perangkat Keras</string>
    <string name="force_hw_vertex_shaders_description">Tidak pernah memakai jalur vertex shader perangkat lunak yang lambat. Draw yang tidak dapat berjalan di GPU dilewati. Dapat meningkatkan performa, tetapi bisa menyebabkan grafis hilang.</string>
    <string name="disable_surface_texture_copy">Nonaktifkan Salinan Tekstur Permukaan</string>
    <string name="disable_surface_texture_copy_description">Melewati salinan tekstur saat tidak ada sumber yang di-cache. Dapat memberi sedikit peningkatan performa, tetapi bisa menyebabkan bug grafis.</string>
    <string name="disable_flush_cpu_write">Nonaktifkan Flush CPU Write</string>
    <string name="disable_flush_cpu_write_description">Melewati flush permukaan yang di-cache pada penulisan CPU yang sangat kecil. Dapat mengurangi stutter, tetapi bisa menyebabkan bug grafis.</string>
