@@ -0,0 +1,82 @@
+// Copyright 2026 Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+#pragma once
+
+#include <algorithm>
+#include <span>
+#include <string>
+#include <string_view>
+
+#include "video_core/renderer_vulkan/vk_common.h"
+
+namespace Vulkan {
+
+// Filter before calling the driver: an unadvertised extension structure can also be unknown
+// to an Android translation layer. Keep unlinked members zero-initialized for callers.
+inline bool HasQueryExtension(std::span<const std::string> extensions, std::string_view name) {
+    return std::find(extensions.begin(), extensions.end(), name) != extensions.end();
+}
+
+inline auto MakeFeatureQueryChain(uint32_t api_version, std::span<const std::string> extensions) {
+    vk::StructureChain<vk::PhysicalDeviceFeatures2,
+                       vk::PhysicalDevicePortabilitySubsetFeaturesKHR,
+                       vk::PhysicalDeviceExtendedDynamicStateFeaturesEXT,
+                       vk::PhysicalDeviceTimelineSemaphoreFeaturesKHR,
+                       vk::PhysicalDeviceCustomBorderColorFeaturesEXT,
+                       vk::PhysicalDeviceIndexTypeUint8FeaturesEXT,
+                       vk::PhysicalDeviceRobustness2FeaturesEXT,
+                       vk::PhysicalDeviceFragmentShaderInterlockFeaturesEXT,
+                       vk::PhysicalDevicePipelineCreationCacheControlFeaturesEXT,
+                       vk::PhysicalDeviceFragmentShaderBarycentricFeaturesKHR> chain;
+    const auto has = [&](std::string_view name) { return HasQueryExtension(extensions, name); };
+    if (!has(VK_KHR_PORTABILITY_SUBSET_EXTENSION_NAME)) {
+        chain.unlink<vk::PhysicalDevicePortabilitySubsetFeaturesKHR>();
+    }
+    // The EXT feature structure itself was not promoted to Vulkan 1.3.
+    if (!has(VK_EXT_EXTENDED_DYNAMIC_STATE_EXTENSION_NAME)) {
+        chain.unlink<vk::PhysicalDeviceExtendedDynamicStateFeaturesEXT>();
+    }
+    if (api_version < VK_API_VERSION_1_2 && !has(VK_KHR_TIMELINE_SEMAPHORE_EXTENSION_NAME)) {
+        chain.unlink<vk::PhysicalDeviceTimelineSemaphoreFeaturesKHR>();
+    }
+    if (!has(VK_EXT_CUSTOM_BORDER_COLOR_EXTENSION_NAME)) {
+        chain.unlink<vk::PhysicalDeviceCustomBorderColorFeaturesEXT>();
+    }
+    if (api_version < VK_MAKE_API_VERSION(0, 1, 4, 0) &&
+        !has(VK_EXT_INDEX_TYPE_UINT8_EXTENSION_NAME) && !has("VK_KHR_index_type_uint8")) {
+        chain.unlink<vk::PhysicalDeviceIndexTypeUint8FeaturesEXT>();
+    }
+    if (!has(VK_EXT_ROBUSTNESS_2_EXTENSION_NAME)) {
+        chain.unlink<vk::PhysicalDeviceRobustness2FeaturesEXT>();
+    }
+    if (!has(VK_EXT_FRAGMENT_SHADER_INTERLOCK_EXTENSION_NAME)) {
+        chain.unlink<vk::PhysicalDeviceFragmentShaderInterlockFeaturesEXT>();
+    }
+    if (api_version < VK_API_VERSION_1_3 &&
+        !has(VK_EXT_PIPELINE_CREATION_CACHE_CONTROL_EXTENSION_NAME)) {
+        chain.unlink<vk::PhysicalDevicePipelineCreationCacheControlFeaturesEXT>();
+    }
+    if (!has(VK_KHR_FRAGMENT_SHADER_BARYCENTRIC_EXTENSION_NAME)) {
+        chain.unlink<vk::PhysicalDeviceFragmentShaderBarycentricFeaturesKHR>();
+    }
+    return chain;
+}
+
+inline auto MakePropertyQueryChain(uint32_t api_version, std::span<const std::string> extensions) {
+    vk::StructureChain<vk::PhysicalDeviceProperties2, vk::PhysicalDeviceDriverProperties,
+                       vk::PhysicalDevicePortabilitySubsetPropertiesKHR,
+                       vk::PhysicalDeviceExternalMemoryHostPropertiesEXT> chain;
+    const auto has = [&](std::string_view name) { return HasQueryExtension(extensions, name); };
+    if (api_version < VK_API_VERSION_1_2 && !has(VK_KHR_DRIVER_PROPERTIES_EXTENSION_NAME)) {
+        chain.unlink<vk::PhysicalDeviceDriverProperties>();
+    }
+    if (!has(VK_KHR_PORTABILITY_SUBSET_EXTENSION_NAME)) {
+        chain.unlink<vk::PhysicalDevicePortabilitySubsetPropertiesKHR>();
+    }
+    if (!has(VK_EXT_EXTERNAL_MEMORY_HOST_EXTENSION_NAME)) {
+        chain.unlink<vk::PhysicalDeviceExternalMemoryHostPropertiesEXT>();
+    }
+    return chain;
+}
+
+} // namespace Vulkan
